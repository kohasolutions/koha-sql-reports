{
  "name": "koha-sql-reports",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./reports.json": "./reports.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "prove": "node tools/prove.mjs",
    "mutate": "node tools/mutate.mjs"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "22.20.5"
  },
  "files": [
    "dist",
    "reports.json"
  ],
  "sideEffects": false,
  "description": "Tested SQL reports for the Koha library system, and the generator that makes new ones",
  "repository": {
    "type": "git",
    "url": "https://github.com/kohasolutions/koha-sql-reports.git"
  }
}
