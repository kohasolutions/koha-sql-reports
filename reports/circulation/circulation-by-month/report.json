      "sample": "2026-09-01",
      "prompt": "first day of the period"
    },
    {
      "placeholder": "To|date",
      "sample": "2026-11-07",
      "prompt": "last day of the period (included)"
    }
  ],
  "spec": {
    "subject": "activity",
    "mode": "totals",
    "groups": [
      {
        "column": "when",
        "part": "month"
      }
    ],
    "measures": [
      "checkouts",
      "renewals",
      "returns"
    ],
    "filters": [
      {
        "column": "library",
        "op": "ask"
      },
      {
        "column": "when",
        "op": "askBetween"
      }
    ]
  }
