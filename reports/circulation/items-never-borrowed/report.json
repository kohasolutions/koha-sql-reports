{
  "slug": "items-never-borrowed",
  "group": "circulation",
  "title": "Items never borrowed",
  "summary": "Copies at one library that have never been checked out, oldest first: candidates for weeding or promotion.",
  "audience": "everyone",
  "parameters": [
    {
      "placeholder": "Library|branches",
      "sample": "CPL",
      "prompt": "the library (pick from the list Koha shows)"
    }
  ],
  "spec": {
    "subject": "items",
    "mode": "list",
    "columns": [
      "barcode",
      "title",
      "author",
      "callnumber",
      "itemtype",
      "added"
    ],
    "filters": [
      {
        "column": "home",
        "op": "ask"
      },
      {
        "column": "checkouts",
        "op": "atMost",
        "value": 0
      },
      {
        "column": "lastborrowed",
        "op": "empty"
      },
      {
        "column": "lost",
        "op": "no"
      },
      {
        "column": "withdrawn",
        "op": "no"
      }
    ]
  }
}
